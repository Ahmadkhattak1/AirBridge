+/*
+ * The 32-byte v1/v3 and 40-byte v2 formats encode rates differently.
+ * Keep the firmware from overriding the rate/sequence of our injected frames.
+ * The normal descriptor builder has already populated the software sequence.
+ */
+static void rtl8xxxu_airbridge_set_rate(struct rtl8xxxu_txdesc32 *desc,
+                                      int size, u8 rate, bool ht,
+                                      bool short_gi, u8 retries)
+{
+	if (size == sizeof(struct rtl8xxxu_txdesc40)) {
+		struct rtl8xxxu_txdesc40 *desc40 = (void *)desc;
+
+		desc40->txdw3 |= cpu_to_le32(TXDESC40_USE_DRIVER_RATE |
+					    TXDESC_DISABLE_DATA_FB);
+		desc40->txdw4 &= cpu_to_le32(~(0x7fU |
+					     TXDESC40_DATA_RATE_FB_MASK |
+					     TXDESC40_RETRY_LIMIT_MASK));
+		desc40->txdw4 |= cpu_to_le32(rate | TXDESC40_RETRY_LIMIT_ENABLE |
+					     (retries << TXDESC40_RETRY_LIMIT_SHIFT));
+		desc40->txdw5 &= cpu_to_le32(~TXDESC40_SHORT_PREAMBLE);
+		if (ht && short_gi)
+			desc40->txdw5 |= cpu_to_le32(TXDESC40_SHORT_PREAMBLE);
+		desc40->txdw8 &= cpu_to_le32(~TXDESC40_HW_SEQ_ENABLE);
+	} else if (size == sizeof(struct rtl8xxxu_txdesc32)) {
+		desc->txdw4 &= cpu_to_le32(~TXDESC32_HW_SEQ_ENABLE);
+		desc->txdw4 |= cpu_to_le32(TXDESC32_USE_DRIVER_RATE |
+					  TXDESC_DISABLE_DATA_FB);
+		desc->txdw5 &= cpu_to_le32(~(0x3fU | 0x0001ff00U |
+					   TXDESC32_SHORT_GI |
+					   TXDESC32_RETRY_LIMIT_MASK));
+		desc->txdw5 |= cpu_to_le32(rate | TXDESC32_RETRY_LIMIT_ENABLE |
+					   (retries << TXDESC32_RETRY_LIMIT_SHIFT));
+		if (ht && short_gi)
+			desc->txdw5 |= cpu_to_le32(TXDESC32_SHORT_GI);
+	}
+}
+
+static void rtl8xxxu_airbridge_txdesc(struct rtl8xxxu_priv *priv,
+                                    struct ieee80211_hdr *hdr,
+                                    struct ieee80211_tx_info *info,
+                                    struct rtl8xxxu_txdesc32 *desc, u16 pktlen)
+{
+	const struct ieee80211_tx_rate *requested = &info->control.rates[0];
+	bool ht = requested->flags & IEEE80211_TX_RC_MCS;
+	int rate = -1;
+	u8 retries = (info->flags & IEEE80211_TX_CTL_NO_ACK) ? 0 : 2;
+
+	if (!(info->flags & IEEE80211_TX_CTL_INJECTED) || pktlen < 24)
+		return;
+
+	if (airbridge_cck && pktlen >= 32 &&
+	    ieee80211_is_action(hdr->frame_control) &&
+	    !memcmp((u8 *)hdr + 24, "\x7f\x00\xe0\x25" "ABW1", 8)) {
+		rate = DESC_RATE_11M;
+		ht = false;
+		retries = 0;
+	} else if (airbridge_inject_rate &&
+		   (ieee80211_is_data(hdr->frame_control) ||
+		    ieee80211_is_action(hdr->frame_control)) &&
+		   !memcmp(hdr->addr3, "\x00\x25\x00\xff\x94\x73", ETH_ALEN)) {
+		/* The firmware's station rate control has no AWDL association. */
+		if (ht && requested->idx >= 0 && requested->idx <= 15 &&
+		    requested->idx < 8 * priv->tx_paths)
+			rate = DESC_RATE_MCS0 + requested->idx;
+		else if (!ht && info->band == NL80211_BAND_2GHZ &&
+			 requested->idx >= 0 && requested->idx <= 11)
+			rate = requested->idx;
+	}
+
+	if (rate >= 0)
+		rtl8xxxu_airbridge_set_rate(desc, priv->fops->tx_desc_size, rate,
+					  ht, requested->flags & IEEE80211_TX_RC_SHORT_GI,
+					  retries);
+}
